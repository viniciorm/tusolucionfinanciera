APP_NAME="CRM Tu Solución Financiera"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.tusolucionfinanciera.cl

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# Base de datos MySQL / MariaDB en cPanel
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tusoluc1_crm
DB_USERNAME=tusoluc1_crmusr
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Google OAuth 2.0 / OpenID Connect (Credenciales desde Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://crm.tusolucionfinanciera.cl/auth/google/callback

# Cuenta de Servicio para Google Sheets (Solo lectura)
# Ruta absoluta en el servidor privado, FUERA de public_html
GOOGLE_SERVICE_ACCOUNT_PATH=/home/tusoluc1/crm-app/credentials/google-service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=

# Administrador inicial autorizado (Se crea en migrations/seeders en estado activo y sin vincular)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME="Administrador TSF"
